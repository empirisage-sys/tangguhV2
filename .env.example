# =====================================================================
# KONFIGURASI ENVIRONMENT VARIABLES — APLIKASI TANGGUH
# Salin berkas ini ke `.env.local` untuk pengembangan lokal,
# dan masukkan variabel-variabel ini ke Dashboard Vercel (Settings > Environment Variables).
# =====================================================================

# 1. URL Proyek Supabase (Didapat dari: Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# 2. Supabase Anon Key / Public Key (Aman untuk browser / publik)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Supabase Service Role Key (RAHASIA — Hanya dieksekusi di server/admin, JANGAN beri prefix NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 4. URL Utama Situs / Domain (Untuk keperluan redirect konfirmasi email autentikasi)
# Saat lokal: http://localhost:3000
# Saat live di Vercel: https://nama-proyek-anda.vercel.app
NEXT_PUBLIC_SITE_URL=https://nama-proyek-anda.vercel.app
